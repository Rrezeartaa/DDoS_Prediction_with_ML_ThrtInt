   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import tensorflow as tf\n",
    "\n",
    "from sklearn.model_selection import train_test_split, GridSearchCV, StratifiedKFold\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    classification_report, confusion_matrix, balanced_accuracy_score\n",
    ")\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.svm import SVC\n",
    "from xgboost import XGBClassifier\n",
    "\n",
    "\n",
    "class DDoSAnalysis:\n",
    "    def __init__(self, file_path):\n",
    "        self.raw_data = pd.read_csv(file_path, low_memory=False)\n",
    "        self.raw_data.columns = self.raw_data.columns.str.strip()\n",
    "\n",
    "        self.X_train = None\n",
    "        self.X_test = None\n",
    "        self.y_train = None\n",
    "        self.y_test = None\n",
    "\n",
    "        self.models = {}\n",
    "        self.results = {}\n",
    "\n",
    "        self.preprocessor = None\n",
    "        self.dl_result = None\n",
    "\n",
    "        # keep for inspection\n",
    "        self.feature_columns = None\n",
    "        self.target_name = None\n",
    "\n",
    "    # ----------------------------\n",
    "    # Helpers\n",
    "    # ----------------------------\n",
    "    @staticmethod\n",
    "    def _parse_timestamp_if_exists(df, timestamp_col=\"Timestamp\"):\n",
    "        if timestamp_col in df.columns:\n",
    "            df = df.copy()\n",
    "            df[timestamp_col] = pd.to_datetime(df[timestamp_col], errors=\"coerce\")\n",
    "        return df\n",
    "\n",
    "    @staticmethod\n",
    "    def _binary_ddos_target(y_raw):\n",
    "        # 1 => contains \"ddos\", 0 => otherwise\n",
    "        return y_raw.astype(str).str.strip().str.lower().apply(lambda x: 1 if \"ddos\" in x else 0)\n",
    "\n",
    "    # ----------------------------\n",
    "    # Preprocess\n",
    "    # ----------------------------\n",
    "    def preprocess_data(\n",
    "        self,\n",
    "        target_column=\"Label\",\n",
    "        ddos_only_binary=True,\n",
    "        ddos_vs_benign_only=False,\n",
    "        split_mode=\"random\",               # \"random\" or \"time\"\n",
    "        test_size=0.2,\n",
    "        random_state=42,\n",
    "        drop_shortcut_cols=True,\n",
    "        drop_ports=False\n",
    "    ):\n",
    "        \"\"\"\n",
    "        split_mode:\n",
    "          - random: stratified random split\n",
    "          - time: chronological split (no shuffle), better realism\n",
    "        ddos_vs_benign_only:\n",
    "          - if True with ddos_only_binary, keep only BENIGN + DDoS rows\n",
    "        \"\"\"\n",
    "        df = self.raw_data.copy()\n",
    "        df = df.replace([np.inf, -np.inf], np.nan).drop_duplicates()\n",
    "        df = self._parse_timestamp_if_exists(df, \"Timestamp\")\n",
    "\n",
    "        if target_column not in df.columns:\n",
    "            raise ValueError(f\"Target column '{target_column}' not found. Available: {list(df.columns)}\")\n",
    "\n",
    "        self.target_name = target_column\n",
    "        y_raw = df[target_column].astype(str).str.strip()\n",
    "\n",
    "        # optional filtering: only BENIGN + DDoS\n",
    "        if ddos_only_binary and ddos_vs_benign_only:\n",
    "            low = y_raw.str.lower()\n",
    "            keep_mask = (low == \"benign\") | (low.str.contains(\"ddos\"))\n",
    "            df = df.loc[keep_mask].copy()\n",
    "            y_raw = df[target_column].astype(str).str.strip()\n",
    "\n",
    "        # target\n",
    "        if ddos_only_binary:\n",
    "            y = self._binary_ddos_target(y_raw)\n",
    "        else:\n",
    "            y = y_raw.str.lower().astype(\"category\").cat.codes\n",
    "\n",
    "        # drop leakage / shortcut columns\n",
    "        drop_cols = []\n",
    "        if drop_shortcut_cols:\n",
    "            drop_cols += [\"Flow ID\", \"Source IP\", \"Destination IP\"]\n",
    "        drop_cols += [target_column]\n",
    "\n",
    "        # for model inputs, usually drop timestamp\n",
    "        drop_cols += [\"Timestamp\"]\n",
    "\n",
    "        if drop_ports:\n",
    "            drop_cols += [\"Source Port\", \"Destination Port\", \"Src Port\", \"Dst Port\"]\n",
    "\n",
    "        X = df.drop(columns=[c for c in drop_cols if c in df.columns], errors=\"ignore\")\n",
    "\n",
    "        # numeric only\n",
    "        X = X.select_dtypes(include=[np.number])\n",
    "\n",
    "        # remove all-NaN columns\n",
    "        all_nan_cols = [c for c in X.columns if X[c].isna().all()]\n",
    "        if all_nan_cols:\n",
    "            X = X.drop(columns=all_nan_cols)\n",
    "\n",
    "        self.feature_columns = X.columns.tolist()\n",
    "\n",
    "        if split_mode not in {\"random\", \"time\"}:\n",
    "            raise ValueError(\"split_mode must be 'random' or 'time'\")\n",
    "\n",
    "        if split_mode == \"random\":\n",
    "            self.X_train, self.X_test, self.y_train, self.y_test = train_test_split(\n",
    "                X, y,\n",
    "                test_size=test_size,\n",
    "                random_state=random_state,\n",
    "                stratify=y\n",
    "            )\n",
    "        else:\n",
    "            # chronological split; if timestamp exists and parsed, sort by it\n",
    "            if \"Timestamp\" in df.columns and pd.api.types.is_datetime64_any_dtype(df[\"Timestamp\"]):\n",
    "                order_idx = df[\"Timestamp\"].sort_values(kind=\"mergesort\").index\n",
    "                X = X.loc[order_idx]\n",
    "                y = y.loc[order_idx]\n",
    "            # fallback: row order\n",
    "\n",
    "            split_idx = int((1 - test_size) * len(X))\n",
    "            self.X_train, self.X_test = X.iloc[:split_idx], X.iloc[split_idx:]\n",
    "            self.y_train, self.y_test = y.iloc[:split_idx], y.iloc[split_idx:]\n",
    "\n",
    "        print(f\"Split mode: {split_mode}\")\n",
    "        print(\"Train shape:\", self.X_train.shape, \"Test shape:\", self.X_test.shape)\n",
    "        print(\"Train positive ratio:\", float(np.mean(self.y_train)), \"Test positive ratio:\", float(np.mean(self.y_test)))\n",
    "\n",
    "    # ----------------------------\n",
    "    # Pipelines\n",
    "    # ----------------------------\n",
    "    def _build_pipelines(self, random_state=42, fast_svm=True):\n",
    "        if self.X_train is None:\n",
    "            raise ValueError(\"Call preprocess_data() first.\")\n",
    "\n",
    "        numeric_features = self.X_train.columns.tolist()\n",
    "\n",
    "        preprocessor = ColumnTransformer(\n",
    "            transformers=[\n",
    "                (\"num\", Pipeline([\n",
    "                    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "                    (\"scaler\", StandardScaler())\n",
    "                ]), numeric_features)\n",
    "            ],\n",
    "            remainder=\"drop\"\n",
    "        )\n",
    "        self.preprocessor = preprocessor\n",
    "\n",
    "        n_pos = int(np.sum(np.asarray(self.y_train) == 1))\n",
    "        n_neg = int(np.sum(np.asarray(self.y_train) == 0))\n",
    "        scale_pos_weight = (n_neg / n_pos) if n_pos > 0 else 1.0\n",
    "\n",
    "        svm_params = {\n",
    "            \"clf__C\": [1, 10],\n",
    "            \"clf__kernel\": [\"rbf\"]\n",
    "        } if fast_svm else {\n",
    "            \"clf__C\": [0.1, 1, 10],\n",
    "            \"clf__kernel\": [\"linear\", \"rbf\"]\n",
    "        }\n",
    "\n",
    "        models = {\n",
    "            \"SVM\": {\n",
    "                \"pipeline\": Pipeline([\n",
    "                    (\"prep\", preprocessor),\n",
    "                    (\"clf\", SVC(class_weight=\"balanced\", probability=True, random_state=random_state))\n",
    "                ]),\n",
    "                \"params\": svm_params\n",
    "            },\n",
    "            \"RandomForest\": {\n",
    "                \"pipeline\": Pipeline([\n",
    "                    (\"prep\", preprocessor),\n",
    "                    (\"clf\", RandomForestClassifier(\n",
    "                        class_weight=\"balanced\",\n",
    "                        random_state=random_state,\n",
    "                        n_jobs=-1\n",
    "                    ))\n",
    "                ]),\n",
    "                \"params\": {\n",
    "                    \"clf__n_estimators\": [200, 400],\n",
    "                    \"clf__max_depth\": [None, 20, 40],\n",
    "                    \"clf__min_samples_leaf\": [1, 2, 5]\n",
    "                }\n",
    "            },\n",
    "            \"XGBoost\": {\n",
    "                \"pipeline\": Pipeline([\n",
    "                    (\"prep\", preprocessor),\n",
    "                    (\"clf\", XGBClassifier(\n",
    "                        objective=\"binary:logistic\",\n",
    "                        eval_metric=\"logloss\",\n",
    "                        random_state=random_state,\n",
    "                        n_jobs=-1,\n",
    "                        scale_pos_weight=scale_pos_weight\n",
    "                    ))\n",
    "                ]),\n",
    "                \"params\": {\n",
    "                    \"clf__n_estimators\": [200, 400],\n",
    "                    \"clf__max_depth\": [4, 8],\n",
    "                    \"clf__learning_rate\": [0.03, 0.1],\n",
    "                    \"clf__subsample\": [0.8, 1.0]\n",
    "                }\n",
    "            }\n",
    "        }\n",
    "        return models\n",
    "\n",
    "    # ----------------------------\n",
    "    # Train ML\n",
    "    # ----------------------------\n",
    "    def train_ml_models(\n",
    "        self,\n",
    "        random_state=42,\n",
    "        cv_splits=3,\n",
    "        svm_subset_size=80000,\n",
    "        fast_svm=True\n",
    "    ):\n",
    "        \"\"\"\n",
    "        svm_subset_size:\n",
    "          - int (e.g., 80000): fit SVM on stratified subset for speed\n",
    "          - None: fit SVM on full train\n",
    "        \"\"\"\n",
    "        models = self._build_pipelines(random_state=random_state, fast_svm=fast_svm)\n",
    "        cv = StratifiedKFold(n_splits=cv_splits, shuffle=True, random_state=random_state)\n",
    "\n",
    "        self.results = {}\n",
    "        self.models = {}\n",
    "\n",
    "        for name, cfg in models.items():\n",
    "            print(f\"\\nTraining {name}...\")\n",
    "\n",
    "            if name == \"SVM\" and svm_subset_size is not None and svm_subset_size < len(self.X_train):\n",
    "                X_fit, _, y_fit, _ = train_test_split(\n",
    "                    self.X_train,\n",
    "                    self.y_train,\n",
    "                    train_size=svm_subset_size,\n",
    "                    stratify=self.y_train,\n",
    "                    random_state=random_state\n",
    "                )\n",
    "                print(f\"SVM subset size: {len(X_fit)}\")\n",
    "            else:\n",
    "                X_fit, y_fit = self.X_train, self.y_train\n",
    "\n",
    "            grid = GridSearchCV(\n",
    "                estimator=cfg[\"pipeline\"],\n",
    "                param_grid=cfg[\"params\"],\n",
    "                scoring=\"f1\",\n",
    "                cv=cv,\n",
    "                n_jobs=-1,\n",
    "                verbose=1\n",
    "            )\n",
    "            grid.fit(X_fit, y_fit)\n",
    "\n",
    "            best_model = grid.best_estimator_\n",
    "            y_pred = best_model.predict(self.X_test)\n",
    "\n",
    "            self.models[name] = best_model\n",
    "            self.results[name] = {\n",
    "                \"best_params\": grid.best_params_,\n",
    "                \"accuracy\": accuracy_score(self.y_test, y_pred),\n",
    "                \"balanced_accuracy\": balanced_accuracy_score(self.y_test, y_pred),\n",
    "                \"precision\": precision_score(self.y_test, y_pred, zero_division=0),\n",
    "                \"recall\": recall_score(self.y_test, y_pred, zero_division=0),\n",
    "                \"f1\": f1_score(self.y_test, y_pred, zero_division=0),\n",
    "                \"confusion_matrix\": confusion_matrix(self.y_test, y_pred),\n",
    "                \"classification_report\": classification_report(self.y_test, y_pred, digits=4)\n",
    "            }\n",
    "\n",
    "        return self.results\n",
    "\n",
    "    # ----------------------------\n",
    "    # Feature importance\n",
    "    # ----------------------------\n",
    "    def feature_importance(self, model_name=\"RandomForest\", top_n=15, plot=True):\n",
    "        if model_name not in self.models:\n",
    "            raise ValueError(f\"Model '{model_name}' not trained. Run train_ml_models() first.\")\n",
    "\n",
    "        clf = self.models[model_name].named_steps[\"clf\"]\n",
    "        if not hasattr(clf, \"feature_importances_\"):\n",
    "            raise ValueError(f\"{model_name} has no feature_importances_ (use RandomForest or XGBoost).\")\n",
    "\n",
    "        fi_df = pd.DataFrame({\n",
    "            \"feature\": self.X_train.columns.tolist(),\n",
    "            \"importance\": clf.feature_importances_\n",
    "        }).sort_values(\"importance\", ascending=False).head(top_n)\n",
    "\n",
    "        if plot:\n",
    "            plt.figure(figsize=(10, 6))\n",
    "            sns.barplot(data=fi_df, x=\"importance\", y=\"feature\")\n",
    "            plt.title(f\"Top {top_n} Features - {model_name}\")\n",
    "            plt.tight_layout()\n",
    "            plt.show()\n",
    "\n",
    "        return fi_df\n",
    "\n",
    "    # ----------------------------\n",
    "    # Deep learning\n",
    "    # ----------------------------\n",
    "    def deep_learning_model(\n",
    "        self,\n",
    "        random_state=42,\n",
    "        epochs=60,\n",
    "        batch_size=256,\n",
    "        threshold=0.5,\n",
    "        verbose=1\n",
    "    ):\n",
    "        tf.keras.utils.set_random_seed(random_state)\n",
    "\n",
    "        if self.preprocessor is None:\n",
    "            # fallback\n",
    "            numeric_features = self.X_train.columns.tolist()\n",
    "            self.preprocessor = ColumnTransformer(\n",
    "                transformers=[\n",
    "                    (\"num\", Pipeline([\n",
    "                        (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "                        (\"scaler\", StandardScaler())\n",
    "                    ]), numeric_features)\n",
    "                ],\n",
    "                remainder=\"drop\"\n",
    "            )\n",
    "\n",
    "        X_train_proc = self.preprocessor.fit_transform(self.X_train)\n",
    "        X_test_proc = self.preprocessor.transform(self.X_test)\n",
    "\n",
    "        if hasattr(X_train_proc, \"toarray\"):\n",
    "            X_train_proc = X_train_proc.toarray()\n",
    "            X_test_proc = X_test_proc.toarray()\n",
    "\n",
    "        y_train = np.asarray(self.y_train).astype(int)\n",
    "        y_test = np.asarray(self.y_test).astype(int)\n",
    "\n",
    "        n_pos = np.sum(y_train == 1)\n",
    "        n_neg = np.sum(y_train == 0)\n",
    "        total = len(y_train)\n",
    "        class_weight = {\n",
    "            0: total / (2 * n_neg) if n_neg > 0 else 1.0,\n",
    "            1: total / (2 * n_pos) if n_pos > 0 else 1.0\n",
    "        }\n",
    "\n",
    "        model = tf.keras.Sequential([\n",
    "            tf.keras.layers.Input(shape=(X_train_proc.shape[1],)),\n",
    "            tf.keras.layers.Dense(128, activation=\"relu\"),\n",
    "            tf.keras.layers.BatchNormalization(),\n",
    "            tf.keras.layers.Dropout(0.3),\n",
    "\n",
    "            tf.keras.layers.Dense(64, activation=\"relu\"),\n",
    "            tf.keras.layers.BatchNormalization(),\n",
    "            tf.keras.layers.Dropout(0.3),\n",
    "\n",
    "            tf.keras.layers.Dense(1, activation=\"sigmoid\")\n",
    "        ])\n",
    "\n",
    "        model.compile(\n",
    "            optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),\n",
    "            loss=\"binary_crossentropy\",\n",
    "            metrics=[\"accuracy\"]\n",
    "        )\n",
    "\n",
    "        early_stopping = tf.keras.callbacks.EarlyStopping(\n",
    "            monitor=\"val_loss\", patience=8, restore_best_weights=True\n",
    "        )\n",
    "        reduce_lr = tf.keras.callbacks.ReduceLROnPlateau(\n",
    "            monitor=\"val_loss\", factor=0.2, patience=4, min_lr=1e-5\n",
    "        )\n",
    "\n",
    "        history = model.fit(\n",
    "            X_train_proc, y_train,\n",
    "            validation_split=0.2,\n",
    "            epochs=epochs,\n",
    "            batch_size=batch_size,\n",
    "            class_weight=class_weight,\n",
    "            callbacks=[early_stopping, reduce_lr],\n",
    "            verbose=verbose\n",
    "        )\n",
    "\n",
    "        y_prob = model.predict(X_test_proc, verbose=0).ravel()\n",
    "        y_pred = (y_prob >= threshold).astype(int)\n",
    "\n",
    "        self.dl_result = {\n",
    "            \"accuracy\": accuracy_score(y_test, y_pred),\n",
    "            \"balanced_accuracy\": balanced_accuracy_score(y_test, y_pred),\n",
    "            \"precision\": precision_score(y_test, y_pred, zero_division=0),\n",
    "            \"recall\": recall_score(y_test, y_pred, zero_division=0),\n",
    "            \"f1\": f1_score(y_test, y_pred, zero_division=0),\n",
    "            \"confusion_matrix\": confusion_matrix(y_test, y_pred),\n",
    "            \"classification_report\": classification_report(y_test, y_pred, digits=4)\n",
    "        }\n",
    "\n",
    "        plt.figure(figsize=(12, 4))\n",
    "        plt.subplot(1, 2, 1)\n",
    "        plt.plot(history.history[\"accuracy\"], label=\"Train Accuracy\")\n",
    "        plt.plot(history.history[\"val_accuracy\"], label=\"Val Accuracy\")\n",
    "        plt.title(\"DL Accuracy\")\n",
    "        plt.legend()\n",
    "\n",
    "        plt.subplot(1, 2, 2)\n",
    "        plt.plot(history.history[\"loss\"], label=\"Train Loss\")\n",
    "        plt.plot(history.history[\"val_loss\"], label=\"Val Loss\")\n",
    "        plt.title(\"DL Loss\")\n",
    "        plt.legend()\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "        return self.dl_result\n",
    "\n",
    "    # ----------------------------\n",
    "    # Run all\n",
    "    # ----------------------------\n",
    "    def run_all(\n",
    "        self,\n",
    "        target_column=\"Label\",\n",
    "        ddos_only_binary=True,\n",
    "        ddos_vs_benign_only=False,\n",
    "        split_mode=\"random\",\n",
    "        test_size=0.2,\n",
    "        random_state=42,\n",
    "        drop_shortcut_cols=True,\n",
    "        drop_ports=False,\n",
    "        cv_splits=3,\n",
    "        svm_subset_size=80000,\n",
    "        fast_svm=True,\n",
    "        feature_model=\"RandomForest\",\n",
    "        top_n_features=15,\n",
    "        dl_epochs=60,\n",
    "        dl_batch_size=256,\n",
    "        dl_threshold=0.5,\n",
    "        verbose=1\n",
    "    ):\n",
    "        self.preprocess_data(\n",
    "            target_column=target_column,\n",
    "            ddos_only_binary=ddos_only_binary,\n",
    "            ddos_vs_benign_only=ddos_vs_benign_only,\n",
    "            split_mode=split_mode,\n",
    "            test_size=test_size,\n",
    "            random_state=random_state,\n",
    "            drop_shortcut_cols=drop_shortcut_cols,\n",
    "            drop_ports=drop_ports\n",
    "        )\n",
    "\n",
    "        ml_results = self.train_ml_models(\n",
    "            random_state=random_state,\n",
    "            cv_splits=cv_splits,\n",
    "            svm_subset_size=svm_subset_size,\n",
    "            fast_svm=fast_svm\n",
    "        )\n",
    "\n",
    "        fi_df = self.feature_importance(\n",
    "            model_name=feature_model,\n",
    "            top_n=top_n_features,\n",
    "            plot=True\n",
    "        )\n",
    "\n",
    "        dl_result = self.deep_learning_model(\n",
    "            random_state=random_state,\n",
    "            epochs=dl_epochs,\n",
    "            batch_size=dl_batch_size,\n",
    "            threshold=dl_threshold,\n",
    "            verbose=verbose\n",
    "        )\n",
    "\n",
    "        rows = []\n",
    "        for model_name, r in ml_results.items():\n",
    "            rows.append({\n",
    "                \"Model\": model_name,\n",
    "                \"Accuracy\": r[\"accuracy\"],\n",
    "                \"Balanced_Accuracy\": r[\"balanced_accuracy\"],\n",
    "                \"Precision\": r[\"precision\"],\n",
    "                \"Recall\": r[\"recall\"],\n",
    "                \"F1\": r[\"f1\"]\n",
    "            })\n",
    "        rows.append({\n",
    "            \"Model\": \"DeepLearning\",\n",
    "            \"Accuracy\": dl_result[\"accuracy\"],\n",
    "            \"Balanced_Accuracy\": dl_result[\"balanced_accuracy\"],\n",
    "            \"Precision\": dl_result[\"precision\"],\n",
    "            \"Recall\": dl_result[\"recall\"],\n",
    "            \"F1\": dl_result[\"f1\"]\n",
    "        })\n",
    "\n",
    "        comparison_df = pd.DataFrame(rows).sort_values(\"F1\", ascending=False).reset_index(drop=True)\n",
    "\n",
    "        print(\"\\n\" + \"=\" * 80)\n",
    "        print(\"FINAL MODEL COMPARISON (sorted by F1)\")\n",
    "        print(\"=\" * 80)\n",
    "        print(comparison_df.to_string(index=False))\n",
    "\n",
    "        return {\n",
    "            \"ml_results\": ml_results,\n",
    "            \"dl_result\": dl_result,\n",
    "            \"feature_importance\": fi_df,\n",
    "            \"comparison_table\": comparison_df\n",
    "        }"
   ]
  },
